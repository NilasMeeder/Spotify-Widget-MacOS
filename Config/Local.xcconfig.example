// Copy to Local.xcconfig (ignored by git) and fill in.

// Your team ID: Xcode → Settings → Accounts, or developer.apple.com/account → Membership.
// A free Apple ID works.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Optional: the client ID of your own app on developer.spotify.com, with redirect URI spotifywidget://callback.
// Needed for Liked Songs.
// SPOTIFY_CLIENT_ID = your_client_id
